<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds AlternativeWeaponsControl.dll. No NuGet packages: every reference is a direct path, so it works offline.
       Needs the .NET SDK (6+), the game, BepInEx in the game folder and the Anchor Chain Workshop item.
       Adjust the paths below or pass them on the command line:
         dotnet build -c Release -p:GameDir="D:\Steam\steamapps\common\Sea Power" -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AlternativeWeaponsControl</AssemblyName>
    <RootNamespace>AlternativeWeaponsControl</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- build number written to the log (UTC time of the build): tells which dll is actually running -->
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMdd.HHmm"))</BuildStamp>

    <GameDir Condition="'$(GameDir)' == ''">D:\Steam\steamapps\common\Sea Power</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Sea Power_Data\Managed</ManagedDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
    <!-- Anchor Chain Workshop item 3380210757 (Sea Power app id 1286220) -->
    <AnchorChainDll Condition="'$(AnchorChainDll)' == ''">$(GameDir)\..\..\workshop\content\1286220\3380210757\AnchorChain.dll</AnchorChainDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Build</_Parameter1>
      <_Parameter2>$(BuildStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AnchorChain"><HintPath>$(AnchorChainDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Noesis.NoesisGUI"><HintPath>$(ManagedDir)\Noesis.NoesisGUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- After every build copy the dll into Release: the mod folder that is uploaded to the Workshop
       (its contents go to StreamingAssets\AlternativeWeaponsControl for a local test) -->
  <Target Name="StageRelease" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\Release" />
    <Message Importance="high" Text="Staged: Release\AlternativeWeaponsControl.dll" />
  </Target>

</Project>
